{
  "name": "11ty-recipe-book",
  "version": "2.0.0",
  "description": "",
  "main": "index.html",
  "scripts": {
    "watch:sass": "sass  --no-source-map --watch src/sass:docs/css",
    "watch:eleventy": "eleventy --serve",
    "build:sass": "sass  --no-source-map src/sass:docs/css",
    "build:eleventy": "eleventy",
    "postbuild": "postcss docs/css/*.css -u autoprefixer cssnano -r --no-map",
    "start": "npm-run-all build:sass --parallel watch:*",
    "build": "npm-run-all build:sass build:eleventy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timklapdor/recipe-book.git"
  },
  "author": "timklapdor",
  "license": "ISC",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "autoprefixer": "^10.6.1",
    "cssnano": "^9.2.0",
    "markdown-it": "^14.3.2",
    "npm-run-all2": "^9.0.3",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "sass": "^1.105.1"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
